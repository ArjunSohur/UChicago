    RowBox[{
    "Linear", " ", "Regression", " ", "for", " ", "extrapolated", " ", 
     "slope"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fit2", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{"EtildeLogData", ",", "x", ",", "x"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"slope2", "=", 
     RowBox[{
      RowBox[{"fit2", "[", "\"\<ParameterTableEntries\>\"", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
