Cell[CellGroupData[{

Cell["Cubic Splines", "Section",
 CellChangeTimes->{{3.852230058682136*^9, 
  3.8522300625820017`*^9}},ExpressionUUID->"4419d5d5-4a83-480f-8f91-\
1721dac035e5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"20", "x"}], "]"}], "+", 
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{"5", 
       RowBox[{"x", "/", "2"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nodelist", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"f", "[", "x", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1", ",", "0.1"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
   RowBox[{"ListPlot", "[", "nodelist", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cs1", "=", 
   RowBox[{
    RowBox[{
    "ResourceFunction", "[", "\"\<CubicSplineInterpolation\>\"", "]"}], "[", 
    RowBox[{"nodelist", ",", "\"\<NotAKnot\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cs2", "=", 
   RowBox[{
    RowBox[{
    "ResourceFunction", "[", "\"\<CubicSplineInterpolation\>\"", "]"}], "[", 
    RowBox[{"nodelist", ",", "\"\<Natural\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cs3", "=", 
   RowBox[{
    RowBox[{
    "ResourceFunction", "[", "\"\<CubicSplineInterpolation\>\"", "]"}], "[", 
    RowBox[{"nodelist", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Clamped\>\"", ",", 
         RowBox[{
          RowBox[{"f", "'"}], "[", "0", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Clamped\>\"", ",", 
         RowBox[{
          RowBox[{"f", "'"}], "[", "1", "]"}]}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
