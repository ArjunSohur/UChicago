   "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{"funcPlot", " ", "=", " ", 
    RowBox[{"Plot", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "a", ",", " ", "b"}], "}"}], ",", "\n", "  ", 
      RowBox[{"Frame", "       ", "->", " ", "True"}], ",", "\n", "  ", 
      RowBox[{"FrameLabel", "  ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<x\>\"", ",", " ", "\"\<f(x)\>\""}], "}"}]}], ",", "\n", 
      "  ", 
