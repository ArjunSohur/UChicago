    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "Parts"}]}], " ", 
       RowBox[{"(", "d", ")"}]}], "&"}], " ", 
     RowBox[{"(", "e", ")"}]}], ":", 
    RowBox[{"Gauss", "-", 
     RowBox[{"Seidel", " ", 
      RowBox[{"Computations", "--"}]}], "-"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"rGS", "=", 
     RowBox[{"IterateSystem", "[", 
      RowBox[{"A", ",", "b", ",", "x0", ",", "maxIter", ",", "\"\<GS\>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rGStilde", "=", 
     RowBox[{"IterateSystem", "[", 
      RowBox[{
      "Atilde", ",", "btilde", ",", "x0", ",", "maxIter", ",", "\"\<GS\>\""}],
       "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"plotGS", "=", 
    RowBox[{"ListLogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rGS", ",", "rGStilde"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Darker", "[", "Green", "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"Orange", ",", "Dashed"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
      RowBox[{
      "PlotLabel", "->", "\"\<Gauss-Seidel Method Residual Convergence\>\""}],
       ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Iteration (k)\>\"", 
         ",", "\"\<||r^(k)||_\\\\[Infinity]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
