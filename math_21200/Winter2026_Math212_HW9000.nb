Cell["Visualizing the Fit", "Text",
 CellChangeTimes->{
  3.9822551922609005`*^9},ExpressionUUID->"f5ded2ac-3eeb-0744-bc39-\
37db6f51c6f6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"yOpt", "=", 
    RowBox[{"RK4Solve", "[", 
     RowBox[{"kStar", ",", "tData", ",", "T0", ",", "Tenv"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"experimentalPlot", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{"{", 
        RowBox[{"tData", ",", "TData"}], "}"}], "]"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Red", ",", 
         RowBox[{"PointSize", "[", "0.015", "]"}]}], "]"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", "\"\<Experimental Data\>\"", "}"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"numericalPlot", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{"{", 
        RowBox[{"tData", ",", "yOpt"}], "}"}], "]"}], ",", 
      RowBox[{"PlotStyle", "->", "Blue"}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", "\"\<RK4 Fit\>\"", "}"}]}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"experimentalPlot", ",", "numericalPlot", ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (minutes)\>\"", ",", "\"\<Scaled Temperature\>\""}], 
     "}"}]}], ",", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<Radiative Cooling: Experimental vs. RK4 Fit\>\""}]}], 
  "]"}]}], "Input",
