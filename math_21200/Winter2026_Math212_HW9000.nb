Cell["\<\
Numerical Optimization (It will take a moment to process. Be patient.)\
\>", "Text",
 CellChangeTimes->{
  3.9822551242804604`*^9, {3.9822551664134216`*^9, 
   3.9822551802355976`*^9}},ExpressionUUID->"e393017b-0d99-9547-a7b8-\
405f6d7c55f2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"optResult", "=", 
   RowBox[{"FindMinimum", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ObjectiveS", "[", "k", "]"}], ",", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "5"}]}], "<=", "k", "<=", 
        RowBox[{"3", "*", 
         RowBox[{"10", "^", 
          RowBox[{"-", "5"}]}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"2", "*", 
        RowBox[{"10", "^", 
         RowBox[{"-", "5"}]}]}]}], "}"}], ",", 
     RowBox[{"AccuracyGoal", "->", "3"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kStar", "=", 
   RowBox[{"k", "/.", " ", 
    RowBox[{"optResult", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Optimal parameter k* = \>\"", ",", "kStar"}], "]"}]}], "Input",\

 CellChangeTimes->{{3.982255129415943*^9, 3.982255129415943*^9}, {
  3.9822556054279423`*^9, 3.9822556134108753`*^9}},
