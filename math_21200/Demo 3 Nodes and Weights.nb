Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Function", " ", "to", " ", "visualize", " ", "Gauss"}], "-", 
    RowBox[{"Legendre", " ", "Nodes", " ", "and", " ", "Weights", " ", 
     RowBox[{"on", "[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "]"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"VisualizeGaussLegendre", "[", "n_Integer", "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "raw", ",", "nodes01", ",", "weights01", ",", "nodes", ",", "weights", 
        ",", "data"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"1.", " ", "Get", " ", "raw", " ", "data", " ", 
        RowBox[{"(", 
         RowBox[{"Defaults", " ", "to", " ", 
          RowBox[{"interval", "[", 
           RowBox[{"0", ",", "1"}], "]"}]}], ")"}]}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"raw", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "are", " ", "nodes"}], ",", 
        RowBox[{
         RowBox[{"raw", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", "are", " ", "weights"}]}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"raw", "=", 
        RowBox[{"NIntegrate`GaussRuleData", "[", 
         RowBox[{"n", ",", "MachinePrecision"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nodes01", "=", 
        RowBox[{"raw", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"weights01", "=", 
        RowBox[{"raw", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"2.", " ", "Rescale", " ", 
         RowBox[{"from", "[", 
          RowBox[{"0", ",", "1"}], "]"}], " ", 
         RowBox[{"to", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "*)"}], 
       RowBox[{"nodes", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "*", "nodes01"}], ")"}], "-", "1"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"weights", "=", 
        RowBox[{"2", "*", "weights01"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "3.", " ", "Pair", " ", "them", " ", "up", " ", "for", " ", 
         "plotting"}], "*)"}], 
       RowBox[{"data", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"nodes", ",", "weights"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"4.", " ", "Create", " ", "the", " ", "plot"}], "*)"}], 
       RowBox[{"ListPlot", "[", 
        RowBox[{"data", ",", 
         RowBox[{"Filling", "->", "Axis"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.02", "]"}], ",", "Red"}], "}"}]}], ",", 
         RowBox[{"FillingStyle", "->", "Blue"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.1"}], ",", "1.1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{
               RowBox[{"Max", "[", "weights", "]"}], "*", "1.1"}]}], "}"}]}], 
           "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Node Position (x)\>\"", ",", "\"\<Weight (w)\>\""}], 
           "}"}]}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"\"\<Gauss-Legendre Quadrature (n = \>\"", "<>", 
             RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}], ",", 
            "16", ",", "Bold"}], "]"}]}], ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{"Dashed", ",", 
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "0"}], "}"}]}], "}"}], "]"}]}], " ", 
           RowBox[{"(*", 
            RowBox[{"Emphasize", " ", "the", " ", "interval"}], "*)"}], 
           "}"}]}]}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Interactive", " ", "Manipulate"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"VisualizeGaussLegendre", "[", "n", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", "10", ",", "\"\<Number of Nodes (n)\>\""}], "}"}], ",",
        "2", ",", "50", ",", "1", ",", 
       RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.980117782375326*^9, 3.9801178174186516`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"e66a8663-d20b-9f41-a695-6d940c153e7f"],

