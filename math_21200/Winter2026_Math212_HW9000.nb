Cell["Extrapolation", "Text",
 CellChangeTimes->{
  3.982255208476343*^9},ExpressionUUID->"d2387e06-f3aa-c44b-af5f-\
2154d586ff3c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ExtrapolateToTarget", "[", 
    RowBox[{"kStar_", ",", "y0_", ",", "Tenv_", ",", "targetT_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "h", ",", "tExtrap", ",", "yExtrap", ",", "fStar", ",", "k1", ",", "k2",
        ",", "k3", ",", "k4"}], "}"}], ",", 
     RowBox[{
      RowBox[{"h", "=", "0.5"}], ";", "\[IndentingNewLine]", 
      RowBox[{"tExtrap", "=", "0.0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"yExtrap", "=", "y0"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fStar", "[", "T_", "]"}], ":=", 
       RowBox[{
        RowBox[{"-", "kStar"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"T", "^", "4"}], "-", 
          RowBox[{"Tenv", "^", "4"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"yExtrap", ">", "targetT"}], "&&", 
         RowBox[{"tExtrap", "<", "1000"}]}], ",", 
        RowBox[{
         RowBox[{"k1", "=", 
          RowBox[{"fStar", "[", "yExtrap", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"k2", "=", 
          RowBox[{"fStar", "[", 
           RowBox[{"yExtrap", "+", 
            RowBox[{
             RowBox[{"h", "/", "2"}], "*", "k1"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"k3", "=", 
          RowBox[{"fStar", "[", 
           RowBox[{"yExtrap", "+", 
            RowBox[{
             RowBox[{"h", "/", "2"}], "*", "k2"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"k4", "=", 
          RowBox[{"fStar", "[", 
           RowBox[{"yExtrap", "+", 
            RowBox[{"h", "*", "k3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"yExtrap", "=", 
          RowBox[{"yExtrap", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"h", "/", "6"}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{"k1", "+", 
              RowBox[{"2", "*", "k2"}], "+", 
              RowBox[{"2", "*", "k3"}], "+", "k4"}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"tExtrap", "+=", "h"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "tExtrap"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"timeToReach5", "=", 
   RowBox[{"ExtrapolateToTarget", "[", 
    RowBox[{"kStar", ",", "T0", ",", "Tenv", ",", "5.0"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Time to reach T=5: \>\"", ",", "timeToReach5", 
   ",", "\"\< minutes\>\""}], "]"}]}], "Input",
 CellChangeTimes->{{3.9822552130342007`*^9, 3.9822552130342007`*^9}},
 CellLabel->
  "In[139]:=",ExpressionUUID->"25d1c158-c1c1-c049-a70a-8e846d3f6cb0"],

