Cell[CellGroupData[{

Cell["Newton Basis", "Section",
 CellChangeTimes->{{3.978995022011178*^9, 
  3.9789950406931334`*^9}},ExpressionUUID->"df5e5125-8e2a-4b90-b656-\
ecc3f873305b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Newton", "-", 
      RowBox[{"basis", " ", "interpolation", " ", "demo", " ", 
       RowBox[{"(", 
        RowBox[{"visual", " ", "only"}], ")"}], " ", "f", 
       RowBox[{"(", "x", ")"}]}]}], "=", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "Pi", " ", "x"}], "]"}], "-", 
      RowBox[{
      "Click", " ", "in", " ", "the", " ", "plot", " ", "to", " ", "add", " ",
        "a", " ", "node", " ", "x_k", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"y", " ", "is", " ", "taken", " ", "from", " ", "f", 
          RowBox[{"(", "x_k", ")"}]}], ")"}], ".", 
        RowBox[{"-", "After"}]}], " ", "each", " ", "click"}]}]}], ",", 
    RowBox[{
    "draws", " ", "the", " ", "new", " ", "interpolant", " ", "p_n", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"red", ",", "thick"}], ")"}], ".", 
      RowBox[{"-", "Keeps"}]}], " ", "earlier", " ", "p_", "0"}], ",", "...", 
    ",", 
    RowBox[{"p_", 
     RowBox[{"{", 
      RowBox[{"n", "-", "1"}], "}"}], " ", "in", " ", "light", " ", 
     RowBox[{"gray", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"f", ",", "newtonCoefficients", ",", "newtonPartials"}], "]"}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], ":=", 
     RowBox[{"Cos", "[", 
      RowBox[{"2", " ", "Pi", " ", "x"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Newton", " ", "divided"}], "-", 
      RowBox[{"difference", " ", "coefficients", " ", "c_", "0"}]}], ",", "...",
      ",", 
     RowBox[{"c_", 
      RowBox[{"{", 
       RowBox[{"n", "-", "1"}], "}"}], " ", "for", " ", "nodes", " ", "xs", 
      " ", "and", " ", "data", " ", "ys"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"newtonCoefficients", "[", 
      RowBox[{"xs_List", ",", "ys_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "xs", "]"}]}], ",", "dd", ",", 
         RowBox[{"cs", "=", 
          RowBox[{"{", "}"}]}], ",", "k", ",", "i"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"dd", "=", 
         RowBox[{"N", "@", "ys"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"k", "=", "1"}], ",", 
          RowBox[{"k", "<=", "n"}], ",", 
          RowBox[{"k", "++"}], ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"cs", ",", 
             RowBox[{"dd", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"k", "<", "n"}], ",", 
             RowBox[{
              RowBox[{"dd", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"dd", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
                    RowBox[{"dd", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"xs", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "k"}], "]"}], "]"}], "-", 
                    RowBox[{"xs", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", 
                   RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}]}], ";"}]}], 
            "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", "cs"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Partial", " ", "Newton", " ", "polynomials", " ", "p0"}], ",", "...",
      ",", 
     RowBox[{"p_", 
      RowBox[{"{", 
       RowBox[{"n", "-", "1"}], "}"}], " ", "in", " ", "symbol", " ", 
      "xSym"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"newtonPartials", "[", 
      RowBox[{"cs_List", ",", "xs_List", ",", "xSym_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "cs", "]"}]}], "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"cs", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "*", 
            RowBox[{"Product", "[", 
             RowBox[{
              RowBox[{"xSym", "-", 
               RowBox[{"xs", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", 
                RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "m"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{"DynamicModule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xmin", "=", "0"}], ",", 
       RowBox[{"xmax", "=", "1"}], ",", 
       RowBox[{"nodes", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"tol", "=", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}], ",", 
       RowBox[{"xSym", "=", 
        RowBox[{"Unique", "[", "\"\<x\>\"", "]"}]}], ",", 
       RowBox[{"cs", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"partials", "=", 
        RowBox[{"{", "}"}]}], ",", "pt", ",", "xNew"}], "}"}], ",", 
     RowBox[{"Column", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Button", "[", 
             RowBox[{"\"\<Reset\>\"", ",", 
              RowBox[{
               RowBox[{"nodes", "=", 
                RowBox[{"{", "}"}]}], ";", 
               RowBox[{"cs", "=", 
                RowBox[{"{", "}"}]}], ";", 
               RowBox[{"partials", "=", 
                RowBox[{"{", "}"}]}], ";"}]}], "]"}], ",", 
            RowBox[{"Spacer", "[", "10", "]"}], ",", 
            RowBox[{"Button", "[", 
             RowBox[{"\"\<Undo last\>\"", ",", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "nodes", "]"}], ">", "0"}], ",", 
                 RowBox[{
                  RowBox[{"nodes", "=", 
                   RowBox[{"Most", "[", "nodes", "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"cs", "=", 
                   RowBox[{"newtonCoefficients", "[", 
                    RowBox[{"nodes", ",", 
                    RowBox[{"f", "/@", "nodes"}]}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"partials", "=", 
                   RowBox[{"newtonPartials", "[", 
                    RowBox[{"cs", ",", "nodes", ",", "xSym"}], "]"}]}], 
                  ";"}]}], "]"}], ";"}]}], "]"}], ",", 
            RowBox[{"Spacer", "[", "12", "]"}], ",", 
            RowBox[{"Dynamic", "@", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"\"\<Nodes: \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"Length", "[", "nodes", "]"}], "]"}]}], ",", "12"}], 
              "]"}]}]}], "}"}], "]"}], ",", 
         RowBox[{"EventHandler", "[", 
          RowBox[{
           RowBox[{"Dynamic", "@", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "t", ",", "yNodes", ",", "styles", ",", "curves", ",", 
                "gNodes"}], "}"}], ",", 
              RowBox[{
               RowBox[{"cs", "=", 
                RowBox[{"newtonCoefficients", "[", 
                 RowBox[{"nodes", ",", 
                  RowBox[{"f", "/@", "nodes"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"partials", "=", 
                RowBox[{"newtonPartials", "[", 
                 RowBox[{"cs", ",", "nodes", ",", "xSym"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"yNodes", "=", 
                RowBox[{"f", "/@", "nodes"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{"curves", ":", 
                  RowBox[{
                  "f", " ", "plus", " ", "all", " ", "partial", " ", 
                   "interpolants"}]}], ";", 
                 RowBox[{"last", " ", "one", " ", "highlighted"}]}], "*)"}], 
               RowBox[{"curves", "=", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"f", "[", "t", "]"}], "}"}], ",", 
                  RowBox[{"(", 
                   RowBox[{"partials", "/.", " ", 
                    RowBox[{"xSym", "->", "t"}]}], ")"}]}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"styles", "=", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"Directive", "[", 
                    RowBox[{"Black", ",", "Thick"}], "]"}], "}"}], ",", 
                  RowBox[{"Which", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "partials", "]"}], "==", "0"}], 
                    ",", 
                    RowBox[{"{", "}"}], ",", 
                    RowBox[{
                    RowBox[{"Length", "[", "partials", "]"}], "==", "1"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"Directive", "[", 
                    RowBox[{"Red", ",", "Thick"}], "]"}], "}"}], ",", "True", 
                    ",", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Directive", "[", 
                    RowBox[{
                    RowBox[{"GrayLevel", "[", "0.75", "]"}], ",", "Thin"}], 
                    "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Length", "[", "partials", "]"}], "-", "1"}], 
                    "}"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"Directive", "[", 
                    RowBox[{"Red", ",", "Thick"}], "]"}], "}"}]}], "]"}]}], 
                   "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"gNodes", "=", 
                RowBox[{"Graphics", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Directive", "[", 
                    RowBox[{"Red", ",", 
                    RowBox[{"PointSize", "[", "0.018", "]"}]}], "]"}], ",", 
                   RowBox[{"Point", "[", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{"nodes", ",", "yNodes"}], "}"}], "]"}], "]"}]}], 
                  "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"Show", "[", 
                RowBox[{
                 RowBox[{"Plot", "[", 
                  RowBox[{
                   RowBox[{"Evaluate", "[", "curves", "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"t", ",", "xmin", ",", "xmax"}], "}"}], ",", 
                   RowBox[{"PlotRange", "->", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"xmin", ",", "xmax"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1.2"}], ",", "1.2"}], "}"}]}], "}"}]}], ",", 
                   RowBox[{"PlotStyle", "->", "styles"}], ",", 
                   RowBox[{"AxesLabel", "->", 
                    RowBox[{"{", 
                    RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
                   RowBox[{"ImageSize", "->", "750"}]}], "]"}], ",", 
                 "gNodes"}], "]"}]}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<MouseDown\>\"", ":>", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"pt", "=", 
                RowBox[{"MousePosition", "[", "\"\<Graphics\>\"", "]"}]}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"pt", "=!=", "None"}], ",", 
                 RowBox[{
                  RowBox[{"xNew", "=", 
                   RowBox[{"Clip", "[", 
                    RowBox[{
                    RowBox[{"pt", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"xmin", ",", "xmax"}], "}"}]}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"(*", 
                   RowBox[{
                    RowBox[{"ignore", " ", "near"}], "-", 
                    RowBox[{
                    "duplicates", " ", "to", " ", "avoid", " ", "division", 
                    " ", 
                    RowBox[{"by", "~", "0"}]}]}], "*)"}], 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "nodes", "]"}], "==", "0"}], "||", 
                    
                    RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"xNew", "-", "nodes"}], "]"}], "]"}], ">", 
                    "tol"}]}], ",", 
                    RowBox[{
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"nodes", ",", "xNew"}], "]"}], ";"}]}], "]"}], 
                  ";"}]}], "]"}], ";"}], ")"}]}], "}"}]}], "]"}]}], "}"}], 
       ",", 
       RowBox[{"Spacings", "->", "1.2"}]}], "]"}]}], "]"}], "\n"}]}]], "Input",\

