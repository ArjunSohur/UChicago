Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"2.", " ", "Gauss"}], "-", 
    RowBox[{"Seidel", " ", "Method", " ", "Implementation"}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "==="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"GaussSeidelMethod", "[", 
     RowBox[{
      RowBox[{"A_", "?", "MatrixQ"}], ",", 
      RowBox[{"b_", "?", "VectorQ"}], ",", 
      RowBox[{"x0_", "?", "VectorQ"}], ",", 
      RowBox[{"tol_", "?", "NumericQ"}], ",", "maxIter_Integer", ",", 
      RowBox[{"printSteps_", ":", "False"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "LMat", ",", "UMat", ",", "DMat", ",", "LDinv", ",", "x", ",", "xNew", 
        ",", "k", ",", "normDiff", ",", "normNew"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Extract", " ", "strictly", " ", "lower"}], ",", 
        RowBox[{"strictly", " ", "upper"}], ",", 
        RowBox[{"and", " ", "diagonal", " ", "components"}]}], "*)"}], 
      RowBox[{
       RowBox[{"LMat", "=", 
        RowBox[{"LowerTriangularize", "[", 
         RowBox[{"A", ",", 
          RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"UMat", "=", 
        RowBox[{"UpperTriangularize", "[", 
         RowBox[{"A", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"DMat", "=", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Diagonal", "[", "A", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Precompute", " ", 
         RowBox[{"Inverse", "[", 
          RowBox[{"L", "+", "D"}], "]"}]}], "*)"}], 
       RowBox[{"LDinv", "=", 
        RowBox[{"Inverse", "[", 
         RowBox[{"LMat", "+", "DMat"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"x", "=", 
        RowBox[{"N", "[", "x0", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"k", "=", "1"}], ",", 
         RowBox[{"k", "<=", "maxIter"}], ",", 
         RowBox[{"k", "++"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Iteration", " ", 
            RowBox[{"step", ":", "x_new"}]}], "=", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"Inverse", "[", 
               RowBox[{"L", "+", "D"}], "]"}], ".", "U", ".", "x"}]}], "+", 
            RowBox[{
             RowBox[{"Inverse", "[", 
              RowBox[{"L", "+", "D"}], "]"}], ".", "b"}]}]}], "*)"}], 
         RowBox[{
          RowBox[{"xNew", "=", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"LDinv", ".", "UMat", ".", "x"}]}], "+", 
            RowBox[{"LDinv", ".", "b"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"printSteps", ",", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Iteration \>\"", ",", "k", ",", "\"\<: x = \>\"", ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"xNew", ",", 
                RowBox[{"{", 
                 RowBox[{"10", ",", "6"}], "}"}]}], "]"}]}], "]"}]}], "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Convergence", " ", "check", " ", "using", " ", "Infinity", " ", 
            "norm"}], "*)"}], 
          RowBox[{"normDiff", "=", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"xNew", "-", "x"}], ",", "Infinity"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"normNew", "=", 
           RowBox[{"Norm", "[", 
            RowBox[{"xNew", ",", "Infinity"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"normNew", ">", "0"}], "&&", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"normDiff", "/", "normNew"}], ")"}], "<", "tol"}]}], ",", 
            RowBox[{
             RowBox[{"Print", "[", 
              
              RowBox[{"\"\<Gauss-Seidel converged in \>\"", ",", "k", 
               ",", "\"\< iterations.\>\""}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Return", "[", "xNew", "]"}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"x", "=", "xNew"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Gauss-Seidel reached maximum iterations (\>\"", ",", 
         "maxIter", ",", "\"\<) without converging.\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "x", "]"}], ";"}]}], "]"}]}], "\n"}]}]], "Input",\

