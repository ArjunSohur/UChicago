Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Function", " ", "to", " ", "visualize", " ", "Gauss"}], "-", 
    RowBox[{"Chebyshev", " ", "Nodes", " ", "and", " ", "Weights", " ", 
     RowBox[{"on", "[", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "]"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"VisualizeGaussChebyshev", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nodes", ",", "weights", ",", "data", ",", "k"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "1.", " ", "Analytic", " ", "formulas", " ", "for", " ", "Nodes", " ", 
        "and", " ", "Weights"}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{"Nodes", " ", "lie", " ", 
        RowBox[{"on", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "]"}], " ", "automatically", " ", 
        "via", " ", "Cosine"}], "*)"}], 
      RowBox[{
       RowBox[{"nodes", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "*", "k"}], "-", "1"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", "*", "n"}], ")"}]}], "*", "Pi"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Weights", " ", "are", " ", "uniform", " ", "for", " ", "Chebyshev", " ",
          "First", " ", "Kind"}], "*)"}], 
       RowBox[{"weights", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Pi", "/", "n"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "2.", " ", "Pair", " ", "them", " ", "up", " ", "for", " ", 
         "plotting"}], "*)"}], 
       RowBox[{"data", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"nodes", ",", "weights"}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"3.", " ", "Create", " ", "the", " ", "plot"}], "*)"}], 
       RowBox[{"ListPlot", "[", 
        RowBox[{"data", ",", 
         RowBox[{"Filling", "->", "Axis"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
            RowBox[{"Darker", "[", "Green", "]"}]}], "}"}]}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "Green", " ", "to", " ", "distinguish", " ", "from", " ", 
           "Legendre"}], "*)"}], 
         RowBox[{"FillingStyle", "->", 
          RowBox[{"Opacity", "[", 
           RowBox[{"0.5", ",", "Green"}], "]"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.1"}], ",", "1.1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", 
              RowBox[{
               RowBox[{"Max", "[", "weights", "]"}], "*", "1.5"}]}], "}"}]}], 
           "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<Node Position (x)\>\"", ",", "\"\<Weight (w)\>\""}], 
           "}"}]}], ",", 
         RowBox[{"GridLines", "->", "Automatic"}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"\"\<Gauss-Chebyshev Quadrature (n = \>\"", "<>", 
             RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}], ",", 
            "16", ",", "Bold"}], "]"}]}], ",", 
         RowBox[{"Epilog", "->", 
          RowBox[{"{", 
           RowBox[{"Dashed", ",", 
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", "0"}], "}"}]}], "}"}], "]"}], ",", 
            RowBox[{"(*", 
             RowBox[{
             "Add", " ", "a", " ", "text", " ", "label", " ", "showing", " ", 
              "the", " ", "uniform", " ", "weight", " ", "value"}], "*)"}], 
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"\"\<Weights = \[Pi]/\>\"", "<>", 
                 RowBox[{"ToString", "[", "n", "]"}]}], ",", "12", ",", 
                RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{
                 RowBox[{"Max", "[", "weights", "]"}], "*", "1.2"}]}], 
               "}"}]}], "]"}]}], "}"}]}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Interactive", " ", "Manipulate"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"VisualizeGaussChebyshev", "[", "n", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", "10", ",", "\"\<Number of Nodes (n)\>\""}], "}"}], ",",
        "2", ",", "50", ",", "1", ",", 
       RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}]}], 
    "]"}]}]}]], "Input",
