Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Part"}]}], " ", 
     RowBox[{"(", "f", ")"}]}], ":", 
    RowBox[{
     RowBox[{"Spectral", " ", 
      RowBox[{"Analysis", "--"}]}], "-"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ComputeTGS", "[", "mat_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"D", ",", "L", ",", "U"}], "}"}], ",", 
       RowBox[{
        RowBox[{"D", "=", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"Diagonal", "[", "mat", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"L", "=", 
         RowBox[{"LowerTriangularize", "[", 
          RowBox[{"mat", ",", 
           RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"U", "=", 
         RowBox[{"UpperTriangularize", "[", 
          RowBox[{"mat", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"-", 
         RowBox[{
          RowBox[{"Inverse", "[", 
           RowBox[{"D", "+", "L"}], "]"}], ".", "U"}]}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Tgs", "=", 
     RowBox[{"ComputeTGS", "[", "A", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"TgsTilde", "=", 
     RowBox[{"ComputeTGS", "[", "Atilde", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhoGS", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"N", "[", "Tgs", "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhoGStilde", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"N", "[", "TgsTilde", "]"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Spectral Radius of T_GS (Original): \>\"", ",", "rhoGS"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
