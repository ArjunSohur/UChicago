Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Initialize", " ", "and", " ", "clear", " ", "context"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Exact", " ", "solution", " ", "evaluated", " ", "at", " ", "t"}], "=", 
     "1"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"exactY", "=", "E"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", "b", ")"}], " ", "Compute", " ", "Y_h", " ", "for", " ", 
       "k"}], "=", "3"}], ",", "...", ",", "11"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Note", ":", 
      RowBox[{"We", " ", "calculate", " ", "up", " ", "to", " ", "k"}]}], "=", 
     RowBox[{
      RowBox[{"11", " ", "so", " ", "we", " ", "have", " ", "Y_", 
       RowBox[{"{", 
        RowBox[{"h", "/", "2"}], "}"}], " ", "available", " ", "for", " ", 
       "k"}], "=", 
      RowBox[{"10", " ", "in", " ", "part", " ", 
       RowBox[{"(", "e", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Ydata", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"h", ",", "Nsteps", ",", "yVals"}], "}"}], ",", 
         RowBox[{
          RowBox[{"h", "=", 
           RowBox[{"2", "^", 
            RowBox[{"-", "k"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Nsteps", "=", 
           RowBox[{"2", "^", "k"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Initialize", " ", "solution", " ", "array"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
            "indices", " ", "1", " ", "and", " ", "2", " ", "correspond", " ",
              "to", " ", "y_", "0", " ", "and", " ", "y_", "1"}]}], "*)"}], 
          RowBox[{"yVals", "=", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"0", ",", 
             RowBox[{"Nsteps", "+", "1"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"yVals", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", "1"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"yVals", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "=", 
           RowBox[{"Exp", "[", 
            RowBox[{"h", "^", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Two", "-", 
            RowBox[{"step", " ", "Adams"}], "-", 
            RowBox[{"Bashforth", " ", "Iteration"}]}], "*)"}], 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"n", "=", "1"}], ",", 
            RowBox[{"n", "<=", 
             RowBox[{"Nsteps", "-", "1"}]}], ",", 
            RowBox[{"n", "++"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"yVals", "[", 
               RowBox[{"[", 
                RowBox[{"n", "+", "2"}], "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"yVals", "[", 
                RowBox[{"[", 
                 RowBox[{"n", "+", "1"}], "]"}], "]"}], "+", 
               RowBox[{
                RowBox[{"h", "^", "2"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"3", " ", "n", "*", 
                   RowBox[{"yVals", "[", 
                    RowBox[{"[", 
                    RowBox[{"n", "+", "1"}], "]"}], "]"}]}], "-", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"n", "-", "1"}], ")"}], "*", 
                   RowBox[{"yVals", "[", 
                    RowBox[{"[", "n", "]"}], "]"}]}]}], ")"}]}]}]}], ";"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Store", " ", 
            RowBox[{"{", 
             RowBox[{"h", ",", "Y_h"}], "}"}]}], "*)"}], 
          RowBox[{"{", 
           RowBox[{"h", ",", 
            RowBox[{"yVals", "[", 
             RowBox[{"[", 
              RowBox[{"Nsteps", "+", "1"}], "]"}], "]"}]}], "}"}]}]}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "3", ",", "11"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Extract", " ", "data", " ", "specifically", " ", "for", " ", "k"}], "=",
       "3"}], ",", "...", ",", "10"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"YhData", "=", 
     RowBox[{"Ydata", "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "8"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Calculate", " ", "E_h", " ", "and", " ", "construct", " ", "log"}], "-", 
     RowBox[{"log", " ", "coordinates", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"log", 
         RowBox[{"(", "h", ")"}]}], ",", 
        RowBox[{"log", 
         RowBox[{"(", "E_h", ")"}]}]}], "}"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EhLogData", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Log", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "exactY"}], "]"}], "]"}]}],
          "}"}], "&"}], ",", "YhData"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"(", "c", ")"}], " ", "Linear", " ", "Regression", " ", "for", " ",
      "slope", " ", "p"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fit1", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{"EhLogData", ",", "x", ",", "x"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"slope1", "=", 
     RowBox[{
      RowBox[{"fit1", "[", "\"\<ParameterTableEntries\>\"", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"intercept1", "=", 
     RowBox[{
      RowBox[{"fit1", "[", "\"\<ParameterTableEntries\>\"", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<--- Part (c) ---\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Estimated slope p (Original AB2): \>\"", ",", "slope1"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "Plot", " ", "for", " ", "Original", " ", "Error"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"plot1", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"EhLogData", ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<ln(h)\>\"", ",", "\"\<ln(E_h)\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Log-Log Plot of Global Error E_h\>\""}],
       ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PointSize", "[", "0.015", "]"}], ",", "Blue"}], "}"}]}]}], 
     "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"(", "e", ")"}], " ", "Richardson", " ", "Extrapolation"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"4", "/", "3"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"b", "=", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "3"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Construct", "\\", "widetilde"}], 
       RowBox[{"{", "Y", "}"}], "_h", " ", "for", " ", "k"}], "=", "3"}], ",",
      "...", ",", "10"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"YtildeData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"h", ",", "Yh", ",", "YhHalf"}], "}"}], ",", 
         RowBox[{
          RowBox[{"h", "=", 
           RowBox[{"Ydata", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Yh", "=", 
           RowBox[{"Ydata", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"YhHalf", "=", 
           RowBox[{"Ydata", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"This", " ", "is", " ", "Y_", 
             RowBox[{"{", 
              RowBox[{"h", "/", "2"}], "}"}], " ", "since", " ", "step", " ", 
             "size", " ", "halves", " ", "with", " ", "k"}], "+", "1"}], 
           "*)"}], 
          RowBox[{"{", 
           RowBox[{"h", ",", 
            RowBox[{
             RowBox[{"a", "*", "YhHalf"}], "+", 
             RowBox[{"b", "*", "Yh"}]}]}], "}"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "8"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Calculate", "\\", "widetilde"}], 
      RowBox[{"{", "E", "}"}], "_h", " ", "and", " ", "construct", " ", 
      "log"}], "-", 
     RowBox[{"log", " ", "coordinates"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EtildeLogData", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{"Log", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "exactY"}], "]"}], "]"}]}],
