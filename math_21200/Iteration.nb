   RowBox[{
    RowBox[{"gammaValues", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "^", 
        RowBox[{"-", "2"}]}], ",", 
       RowBox[{"2", "^", 
        RowBox[{"-", "4"}]}], ",", 
