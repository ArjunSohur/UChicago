Notebook[{

Cell[CellGroupData[{
Cell["Q9001", "Section",
 CellChangeTimes->{{3.982254936521269*^9, 
  3.982254937540983*^9}},ExpressionUUID->"6954b4af-1dc2-594a-b9be-\
357fea822424"],

Cell["Import the data from the CSV file", "Text",
 CellChangeTimes->{{3.9822550822654724`*^9, 
  3.982255089613102*^9}},ExpressionUUID->"23d7bf3a-d37c-1346-b4ea-\
70248516ab19"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"\"\<radiative_cooling_data.csv\>\"", ",", "\"\<CSV\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"headers", "=", 
   RowBox[{"First", "[", "data", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Dset", "=", 
   RowBox[{"Rest", "[", "data", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tData", "=", 
   RowBox[{"Dset", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"TData", "=", 
   RowBox[{"Dset", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Tenv", "=", "3.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T0", "=", 
   RowBox[{"TData", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.980968166242282*^9, 3.980968166245371*^9}, {
   3.9809682614967737`*^9, 3.980968265079362*^9}, {3.980968295543406*^9, 
   3.980968295874793*^9}, {3.9809683967523127`*^9, 3.980968398155992*^9}, {
   3.9822549993065166`*^9, 3.9822550095761814`*^9}, 3.98225504162887*^9, 
   3.9822552534213867`*^9},
 CellLabel->
  "In[121]:=",ExpressionUUID->"0bbdcfde-2981-4927-b1dc-06a0d5888840"],

Cell["RK4 Implementation", "Text",
 CellChangeTimes->{{3.982255065178879*^9, 
  3.9822550710347176`*^9}},ExpressionUUID->"6512ee5a-3ca8-6f4b-bafb-\
5cfcee2d0ae6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RK4Solve", "[", 
   RowBox[{
    RowBox[{"k_", "?", "NumericQ"}], ",", "tArray_List", ",", 
    RowBox[{"y0_", "?", "NumericQ"}], ",", 
    RowBox[{"Tenv_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "h", ",", "n", ",", "y", ",", "f", ",", "k1", ",", "k2", ",", "k3", ",", 
      "k4"}], "}"}], ",", 
    RowBox[{
     RowBox[{"h", "=", 
      RowBox[{
       RowBox[{"tArray", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"tArray", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "tArray", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"y", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0.", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"y", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "=", "y0"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"f", "[", "T_", "]"}], ":=", 
      RowBox[{
       RowBox[{"-", "k"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"T", "^", "4"}], "-", 
         RowBox[{"Tenv", "^", "4"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<", "n"}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{
        RowBox[{"k1", "=", 
         RowBox[{"f", "[", 
          RowBox[{"y", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"k2", "=", 
         RowBox[{"f", "[", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"h", "/", "2"}], "*", "k1"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"k3", "=", 
         RowBox[{"f", "[", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"h", "/", "2"}], "*", "k2"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"k4", "=", 
         RowBox[{"f", "[", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", 
           RowBox[{"h", "*", "k3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"[", 
           RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{"y", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"h", "/", "6"}], ")"}], "*", 
           RowBox[{"(", 
            RowBox[{"k1", "+", 
             RowBox[{"2", "*", "k2"}], "+", 
             RowBox[{"2", "*", "k3"}], "+", "k4"}], ")"}]}]}]}], ";"}]}], 
      "]"}], ";", "\[IndentingNewLine]", "y"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.982255049065504*^9, 3.9822550490665035`*^9}},
 CellLabel->
  "In[129]:=",ExpressionUUID->"5748c0a6-f1a9-964b-b206-6c0f750fd03d"],

Cell["Objective Function Formulation", "Text",
 CellChangeTimes->{
  3.982255100349449*^9},ExpressionUUID->"cc63fc9f-1b48-e84f-abda-\
fe48b591b345"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ObjectiveS", "[", 
    RowBox[{"k_", "?", "NumericQ"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "yApprox", "}"}], ",", 
     RowBox[{
      RowBox[{"yApprox", "=", 
       RowBox[{"RK4Solve", "[", 
        RowBox[{"k", ",", "tData", ",", "T0", ",", "Tenv"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"yApprox", "-", "TData"}], ")"}], "^", "2"}], "]"}]}]}], 
    "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"ObjectiveS", "[", "k", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "5"}]}], ",", 
     RowBox[{"3", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "5"}]}]}]}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<k\>\"", ",", "\"\<S(k)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Objective Function Convexity\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.98225510473312*^9, 3.9822551047341194`*^9}},
 CellLabel->
  "In[130]:=",ExpressionUUID->"8b0f9251-f8a7-ad43-bffe-a485402d3ab5"],

