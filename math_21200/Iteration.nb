       "\[IndentingNewLine]", 
       RowBox[{"sol4J", "=", 
        RowBox[{"JacobiMethod", "[", 
         RowBox[{"A4", ",", "b4", ",", "x0Ex4", ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "10"}]}], ",", "maxIterEx4", ",", "False"}], "]"}]}], 
