Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{"Sin", "[", 
    RowBox[{"4", "x"}], "]"}]}], ";", 
  RowBox[{"v", "=", 
   RowBox[{
    RowBox[{"x", "^", "3"}], "-", 
    RowBox[{"x", "^", "2"}], "+", 
    RowBox[{"x", "/", "2"}]}]}], ";", 
  RowBox[{"w", "=", 
   RowBox[{
    RowBox[{"Sin", "[", 
     RowBox[{"15", " ", 
      RowBox[{"x", "^", "2"}]}], "]"}], "+", 
    RowBox[{"x", "/", "2"}]}]}], ";", 
  RowBox[{"Manipulate", "[", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"i", " ", "u"}], "+", 
       RowBox[{"j", " ", "v"}], "+", 
       RowBox[{"k", " ", "w"}]}], " ", ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "}"}]}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"-", "2"}], ",", "2", ",", 
      RowBox[{"Appearance", "\[Rule]", "\"\<Labeled\>\""}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", 
      RowBox[{"-", "2"}], ",", "2", ",", 
      RowBox[{"Appearance", "\[Rule]", "\"\<Labeled\>\""}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"-", "2"}], ",", "2", ",", 
      RowBox[{"Appearance", "\[Rule]", "\"\<Labeled\>\""}]}], "}"}], ",", 
    RowBox[{"SaveDefinitions", "\[Rule]", "True"}]}], "]"}]}]], "Input",
