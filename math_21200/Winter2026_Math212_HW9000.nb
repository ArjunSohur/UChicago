In[139]:=",ExpressionUUID->"7b149362-4307-3f49-b585-3e67454b987f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "1"}], "/", 
    RowBox[{"(", 
     RowBox[{"0.000023892789682710313`", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "^", "4"}], "-", 
        RowBox[{"3", "^", "4"}]}], ")"}]}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "10", ",", "5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9822603353179283`*^9, 3.982260370117243*^9}, 
