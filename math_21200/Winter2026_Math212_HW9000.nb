Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Initialization", " ", "and", " ", "Setup"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"10", ",", 
         RowBox[{"-", "9"}], ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "10", ",", 
         RowBox[{"-", "9"}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "10", ",", 
         RowBox[{"-", "9"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", 
         RowBox[{"-", "1"}], ",", 
         RowBox[{"-", "1"}], ",", "10"}], "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"b", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"P", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Atilde", "=", 
     RowBox[{"P", ".", "A", ".", 
      RowBox[{"Transpose", "[", "P", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"btilde", "=", 
     RowBox[{"P", ".", "b"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x0", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxIter", "=", "25"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.982260919678362*^9, 3.982260919678362*^9}},
 CellLabel->
  "In[222]:=",ExpressionUUID->"3b926a02-3e5c-c045-94d1-c2e8ffca6191"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Iterative", " ", "Solver", " ", "Definition", " ", "Constructs", " ", 
     "the", " ", "splitting", " ", "A"}], "=", 
    RowBox[{
     RowBox[{"M", "-", 
      RowBox[{"N", " ", "and", " ", "iterates", " ", "x_", 
       RowBox[{"{", 
        RowBox[{"k", "+", "1"}], "}"}]}]}], "=", 
     RowBox[{
      RowBox[{"M", "^", 
       RowBox[{"{", 
        RowBox[{"-", "1"}], "}"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"N", " ", "x_k"}], "+", "b"}], ")"}], "."}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"IterateSystem", "[", 
     RowBox[{
     "mat_", ",", "vec_", ",", "init_", ",", "steps_", ",", "method_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "D", ",", "L", ",", "U", ",", "M", ",", "N", ",", "x", ",", 
        "resNorms"}], "}"}], ",", 
      RowBox[{
       RowBox[{"D", "=", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Diagonal", "[", "mat", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"L", "=", 
        RowBox[{"LowerTriangularize", "[", 
         RowBox[{"mat", ",", 
          RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"U", "=", 
        RowBox[{"UpperTriangularize", "[", 
         RowBox[{"mat", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"method", "==", "\"\<Jacobi\>\""}], ",", 
         RowBox[{
          RowBox[{"M", "=", "D"}], ";", 
          RowBox[{"N", "=", 
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"L", "+", "U"}], ")"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"M", "=", 
           RowBox[{"D", "+", "L"}]}], ";", 
          RowBox[{"N", "=", 
           RowBox[{"-", "U"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"x", "=", "init"}], ";", "\[IndentingNewLine]", 
       RowBox[{"resNorms", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", "steps"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"resNorms", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "=", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"vec", "-", 
              RowBox[{"mat", ".", "x"}]}], ",", "Infinity"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"x", "=", 
           RowBox[{"LinearSolve", "[", 
            RowBox[{"M", ",", 
             RowBox[{
              RowBox[{"N", ".", "x"}], "+", "vec"}]}], "]"}]}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "steps"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "resNorms"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9822609300137672`*^9, 3.9822609300137672`*^9}},
 CellLabel->
  "In[230]:=",ExpressionUUID->"a7d15756-6e3f-2646-9af9-2846585c20d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "Parts"}]}], " ", 
       RowBox[{"(", "a", ")"}]}], "&"}], " ", 
     RowBox[{"(", "b", ")"}]}], ":", 
    RowBox[{
     RowBox[{"Jacobi", " ", 
      RowBox[{"Computations", "--"}]}], "-"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"rJ", "=", 
     RowBox[{"IterateSystem", "[", 
      RowBox[{
      "A", ",", "b", ",", "x0", ",", "maxIter", ",", "\"\<Jacobi\>\""}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rJtilde", "=", 
     RowBox[{"IterateSystem", "[", 
      RowBox[{
      "Atilde", ",", "btilde", ",", "x0", ",", "maxIter", 
       ",", "\"\<Jacobi\>\""}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"plotJ", "=", 
    RowBox[{"ListLogPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rJ", ",", "rJtilde"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"Red", ",", "Dashed"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
      RowBox[{
      "PlotLabel", "->", "\"\<Jacobi Method Residual Convergence\>\""}], ",", 
      
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Iteration (k)\>\"", 
         ",", "\"\<||r^(k)||_\\\\[Infinity]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Original System\>\"", ",", "\"\<Permuted System\>\""}], 
        "}"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9822609385587063`*^9, 3.9822609385587063`*^9}},
 CellLabel->
