        RowBox[{"Blue", ",", " ", 
         RowBox[{"Thickness", "[", "0.003", "]"}]}], "}"}]}], ",", "\n", "  ", 
      RowBox[{"GridLines", "   ", "->", " ", "Automatic"}], ",", "\n", "  ", 
      RowBox[{"PlotLabel", "   ", "->", " ", 
