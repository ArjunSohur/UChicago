Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Jacobi", " ", "Method", " ", "Implementation"}], 
   "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "==="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"JacobiMethod", "[", 
     RowBox[{
      RowBox[{"A_", "?", "MatrixQ"}], ",", 
      RowBox[{"b_", "?", "VectorQ"}], ",", 
      RowBox[{"x0_", "?", "VectorQ"}], ",", 
      RowBox[{"tol_", "?", "NumericQ"}], ",", "maxIter_Integer", ",", 
      RowBox[{"printSteps_", ":", "False"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "DMat", ",", "Dinv", ",", "x", ",", "xNew", ",", "k", ",", "normDiff", 
        ",", "normNew"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Extract", " ", "diagonal", " ", "matrix", " ", "and", " ", "compute", 
        " ", "its", " ", "inverse"}], "*)"}], 
      RowBox[{
       RowBox[{"DMat", "=", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Diagonal", "[", "A", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Dinv", "=", 
        RowBox[{"Inverse", "[", "DMat", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"x", "=", 
        RowBox[{"N", "[", "x0", "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"Ensure", " ", "numerical", " ", "evaluation"}], "*)"}], 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"k", "=", "1"}], ",", 
         RowBox[{"k", "<=", "maxIter"}], ",", 
         RowBox[{"k", "++"}], ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Iteration", " ", 
            RowBox[{"step", ":", "x_new"}]}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"D", "^", 
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}]}], ".", 
             RowBox[{"(", 
              RowBox[{"D", "-", "A"}], ")"}], ".", "x"}], "+", 
            RowBox[{
             RowBox[{"D", "^", 
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}]}], ".", "b"}]}]}], "*)"}], 
         RowBox[{
          RowBox[{"xNew", "=", 
           RowBox[{
            RowBox[{"Dinv", ".", 
             RowBox[{"(", 
              RowBox[{"DMat", "-", "A"}], ")"}], ".", "x"}], "+", 
            RowBox[{"Dinv", ".", "b"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Optional", " ", "printing", " ", "of", " ", "intermediate", " ", 
            "steps"}], "*)"}], 
          RowBox[{"If", "[", 
           RowBox[{"printSteps", ",", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Iteration \>\"", ",", "k", ",", "\"\<: x = \>\"", ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"xNew", ",", 
                RowBox[{"{", 
                 RowBox[{"10", ",", "6"}], "}"}]}], "]"}], 
              ",", "\"\<, Error = \>\"", ",", 
              RowBox[{"NumberForm", "[", 
               RowBox[{"normDiff", ",", 
                RowBox[{"{", 
                 RowBox[{"10", ",", "6"}], "}"}]}], "]"}]}], "]"}]}], "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Convergence", " ", "check", " ", "using", " ", "Infinity", " ", 
            "norm"}], "*)"}], 
          RowBox[{"normDiff", "=", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"xNew", "-", "x"}], ",", "Infinity"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"normNew", "=", 
           RowBox[{"Norm", "[", 
            RowBox[{"xNew", ",", "Infinity"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"normNew", ">", "0"}], "&&", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"normDiff", "/", "normNew"}], ")"}], "<", "tol"}]}], ",", 
            RowBox[{
             RowBox[{"Print", "[", 
              
              RowBox[{"\"\<Jacobi converged in \>\"", ",", "k", 
               ",", "\"\< iterations.\>\""}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Return", "[", "xNew", "]"}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"x", "=", "xNew"}], ";"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Jacobi reached maximum iterations (\>\"", ",", "maxIter",
          ",", "\"\<) without converging.\>\""}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "x", "]"}], ";"}]}], "]"}]}], "\n"}]}]], "Input",\

