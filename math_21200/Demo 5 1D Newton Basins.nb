        RowBox[{"\"\<f(x)\>\"", ",", " ", "Bold", ",", " ", "13"}], "]"}]}], ",",
       "\n", "  ", 
      RowBox[{"ImageSize", "   ", "->", " ", "700"}], ",", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
