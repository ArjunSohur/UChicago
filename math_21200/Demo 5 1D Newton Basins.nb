Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[HorizontalLine]\[HorizontalLine]", " ", "STEP", " ", "8"}], ":",
      " ", 
     RowBox[{
      RowBox[{"Panel", " ", "2"}], " ", "-", " ", 
      RowBox[{
      "Iteration", " ", "count", " ", 
       "\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\[HorizontalLine]\
\[HorizontalLine]\[HorizontalLine]", "\n", "\n", "   ", "Color", " ", "each", 
       " ", "bar", " ", "by", " ", "how", " ", "many", " ", "steps", " ", 
       "it", " ", 
       RowBox[{"took", ".", "\n", "   ", "White"}]}]}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"converged", " ", 
      RowBox[{"fast", ".", "  ", "Dark"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"converged", " ", 
       RowBox[{"slow", ".", "  ", "Black"}]}], " ", "=", " ", 
      RowBox[{"no", " ", 
       RowBox[{"convergence", "."}]}]}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"maxIter", " ", "=", " ", 
     RowBox[{"Max", "[", "iterCounts", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"iterShade", "[", "i_", "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"convQ", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", "\n", "    ", 
      RowBox[{"GrayLevel", "[", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"iterCounts", "[", 
            RowBox[{"[", "i", "]"}], "]"}], " ", "-", " ", "1"}], ")"}], " ", 
         "/", " ", "maxIter"}]}], "]"}], ",", "\n", "    ", "Black"}], "\n", 
     "  ", "]"}]}], "\n", "\n", 
   RowBox[{
    RowBox[{"iterShades", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"iterShade", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"iterBars", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"iterShades", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "\n", "   ", 
         RowBox[{"Rectangle", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x0List", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", " ", "0"}], "}"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x0List", "[", 
              RowBox[{"[", 
               RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], ",", " ", 
             "1"}], "}"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", 
         RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "\n", "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"iterPlot", " ", "=", " ", 
     RowBox[{"Graphics", "[", "\n", "  ", 
      RowBox[{"iterBars", ",", "\n", "  ", 
       RowBox[{"Frame", "       ", "->", " ", "True"}], ",", "\n", "  ", 
       RowBox[{"FrameLabel", "  ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<x0 (starting point)\>\"", ",", " ", "\"\<\>\""}], 
         "}"}]}], ",", "\n", "  ", 
       RowBox[{"PlotLabel", "   ", "->", " ", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<Iteration Count  (white=fast, gray=slow, black=no \
convergence)\>\"", ",", " ", "Bold", ",", " ", "13"}], "]"}]}], ",", "\n", 
       "  ", 
       RowBox[{"AspectRatio", " ", "->", " ", "0.2"}], ",", "\n", "  ", 
       RowBox[{"ImageSize", "   ", "->", " ", "700"}]}], "\n", "]"}]}], 
    ";"}]}]}]], "Code",
